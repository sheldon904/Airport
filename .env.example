# Airport Environment Variables
# Copy this file to .env and fill in the values

# Application
APP_NAME=Airport
DEBUG=true
ENVIRONMENT=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/airport

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO for local dev)
STORAGE_BUCKET=airport-documents
STORAGE_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1

# Authentication
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TIMEOUT_SECONDS=120

# Email (optional for dev)
SMTP_HOST=localhost
SMTP_PORT=587
FROM_EMAIL=noreply@airport.app

# Agent Configuration
AGENT_TIMEOUT_SECONDS=300
EXTRACTION_CONFIDENCE_THRESHOLD=0.85
REQUIRE_HUMAN_REVIEW_BELOW=0.70

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
